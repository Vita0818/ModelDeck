    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "code-inspector-plugin": "^2.0.9",
    "cross-fetch": "^4.1.0",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
