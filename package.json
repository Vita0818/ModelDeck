    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "code-inspector-plugin": "^2.0.9",
    "cross-fetch": "^4.1.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
